# Environment variables template for AI Backbone
# Copy this file to .env and fill in your actual values

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/ai_backbone
DB_ECHO=false

# LLM Configuration
LLM_PROVIDER=openai
LLM_MODEL=gpt-4
LLM_API_KEY=your_openai_api_key_here
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

# Zoho CRM Credentials
ZOHO_CLIENT_ID=your_zoho_client_id
ZOHO_CLIENT_SECRET=your_zoho_client_secret
ZOHO_REFRESH_TOKEN=your_zoho_refresh_token

# QuickBooks Credentials
QB_CLIENT_ID=your_quickbooks_client_id
QB_CLIENT_SECRET=your_quickbooks_client_secret
QB_REFRESH_TOKEN=your_quickbooks_refresh_token
QB_REALM_ID=your_quickbooks_realm_id

# Google Ads Credentials
GOOGLE_ADS_DEVELOPER_TOKEN=your_developer_token
GOOGLE_ADS_CLIENT_ID=your_google_client_id
GOOGLE_ADS_CLIENT_SECRET=your_google_client_secret
GOOGLE_ADS_REFRESH_TOKEN=your_google_refresh_token
GOOGLE_ADS_CUSTOMER_ID=your_customer_id

# Meta Ads Credentials
META_ACCESS_TOKEN=your_meta_access_token
META_AD_ACCOUNT_ID=your_ad_account_id

# Time Doctor Credentials
TIME_DOCTOR_ACCESS_TOKEN=your_time_doctor_token
TIME_DOCTOR_COMPANY_ID=your_company_id

# Google Sheets Credentials
GOOGLE_SHEETS_CLIENT_ID=your_google_client_id
GOOGLE_SHEETS_CLIENT_SECRET=your_google_client_secret
GOOGLE_SHEETS_REFRESH_TOKEN=your_google_refresh_token

# Scheduler Configuration
SCHEDULER_ENABLED=true

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/ai_backbone.log
